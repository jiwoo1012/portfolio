# Server-only settings. Copy to .env.local and fill in your Resend credentials.
# Never prefix these names with NEXT_PUBLIC_.
# A sender on a domain verified in Resend, for example: JIWOO <contact@example.com>
RESEND_API_KEY=your_resend_api_key_here
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=jiwoo6306@gmail.com

# Optional EmailJS settings for the navigation contact letter.
# Use the public key only, never an EmailJS private key.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
